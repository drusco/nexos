{
  "name": "nexos",
  "version": "0.0.0-development",
  "description": "Create JavaScript proxies with full event-driven trap control.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "author": "Pedro Gallardo",
  "license": "MIT",
  "homepage": "https://drusco.github.io/nexos/",
  "scripts": {
    "prepare": "husky install",
    "dev": "tsc --watch",
    "build": "npm run clean && tsc --project src",
    "clean": "rimraf dist coverage .eslintcache",
    "type-check": "tsc --project .",
    "lint": "eslint --cache --fix --resolve-plugins-relative-to . .",
    "lint-check": "eslint --resolve-plugins-relative-to . .",
    "format": "prettier --write --cache .",
    "format-check": "prettier --check .",
    "test": "jest",
    "test-coverage": "jest --coverage"
  },
  "devDependencies": {
    "@jest/globals": "^29.6.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@side/jest-runtime": "^1.1.0",
    "@swc/core": "^1.3.76",
    "@swc/jest": "^0.2.28",
    "@types/jest": "^29.5.3",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "8.50.0",
    "@typescript-eslint/parser": "8.50.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.0.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^8.0.3",
    "jest": "^29.6.1",
    "prettier": "^3.0.0",
    "rimraf": "~5.0.0",
    "semantic-release": "^25.0.9",
    "typescript": "~5.3.0"
  },
  "overrides": {
    "jest-runtime": "29.7.0",
    "npm": "12.0.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drusco/nexos.git"
  },
  "keywords": [
    "proxy",
    "events",
    "mocks"
  ]
}
